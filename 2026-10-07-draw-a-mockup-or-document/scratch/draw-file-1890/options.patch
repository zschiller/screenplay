+function FilePicker({
+  kind,
+  files,
+  onBack,
+}: {
+  kind: "mockup" | "document"
+  files: { id: string; title: string }[]
+  onBack: () => void
+}) {
+  const [query, setQuery] = useState("")
+  const inputRef = useRef<HTMLInputElement>(null)
+  useEffect(() => {
+    let rafId = 0
+    const focusWhenShown = () => {
+      const input = inputRef.current
+      if (!input) return
+      if (getComputedStyle(input).visibility === "hidden") {
+        rafId = requestAnimationFrame(focusWhenShown)
+        return
+      }
+      input.focus()
+    }
+    rafId = requestAnimationFrame(focusWhenShown)
+    return () => cancelAnimationFrame(rafId)
+  }, [])
+  const Icon = kind === "mockup" ? ScribbleIcon : FileTextIcon
+  const q = query.trim().toLowerCase()
+  const matches = q ? files.filter((f) => f.title.toLowerCase().includes(q)) : files
+  const { attach, onScroll, above, below } = useScrollEdges()
+  return (
+    <Command shouldFilter={false} loop className="bg-transparent p-0 [&_[data-slot=command-input-wrapper]]:p-1">
+      <CommandInput ref={inputRef} value={query} onValueChange={setQuery} placeholder={kind === "mockup" ? "Search mockups…" : "Search documents…"} />
+      <CommandList className="max-h-none overflow-visible">
+        {matches.length > 0 && (
+          <div className="relative">
+            <ScrollHairline shown={above} />
+            <div ref={attach} onScroll={onScroll} className="no-scrollbar max-h-72 overflow-y-auto px-1 pb-0.5">
+              <CommandGroup className="p-0">
+                {matches.map((f) => (
+                  <CommandItem key={f.id} value={f.id}>
+                    <Icon />
+                    <span className="flex-1 truncate">{f.title}</span>
+                  </CommandItem>
+                ))}
+              </CommandGroup>
+            </div>
+            <ScrollHairline shown={below} edge="bottom" />
+          </div>
+        )}
+        <CommandGroup className={cn("p-1", matches.length > 0 ? "pt-0.5" : "pt-0")}>
+          <CommandItem value="new" onSelect={onBack}>
+            <PlusIcon className="text-muted-foreground" />
+            <span className="flex-1 truncate">{kind === "mockup" ? "New mockup…" : "New document…"}</span>
+          </CommandItem>
+        </CommandGroup>
+      </CommandList>
+    </Command>
+  )
+}
