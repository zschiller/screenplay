+// SCRATCH (exploration round 1, never committed): ?opt=a|b|c picks a variant
+export const OPT =
+  typeof location === "undefined"
+    ? ""
+    : (new URLSearchParams(location.search).get("opt") ?? "")
+
+/** Scroll to the next item (by selector) that `open` says is unanswered, below the top bar. */
+export function nextOpen(sel: string, open: (el: Element) => boolean) {
+  const top =
+    parseFloat(
+      getComputedStyle(document.documentElement).getPropertyValue("--top-bar")
+    ) || 0
+  const els = [...document.querySelectorAll(sel)].filter(
+    (e) => !(e as HTMLElement).closest("[hidden]") && open(e)
+  )
+  const next =
+    els.find((e) => e.getBoundingClientRect().top > top + 24) ?? els[0]
+  if (next)
+    scrollTo({
+      top: scrollY + next.getBoundingClientRect().top - top - 16,
+      behavior: "instant",
+    })
+}
+
+/** Round 2: two-column layouts (la list+detail, lb answer column, lc captures column, ld index column). */
+export const TWO = OPT.startsWith("l")
+/** The page widens to 1232px on a screen at least 1024px wide. */
+export const WIDE_CSS =
+  "@media (min-width:64rem){.max-w-\\[880px\\]{max-width:1232px}#copy-bar>div{max-width:1184px!important}.sticky>div{max-width:1184px!important}}"
