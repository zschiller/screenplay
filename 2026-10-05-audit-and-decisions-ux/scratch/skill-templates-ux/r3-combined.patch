+
+/** Round 2 A: Previous and Next under the shown finding. */
+function DetailNav({
+  findings,
+  sel,
+  setSel,
+}: {
+  findings: Finding[]
+  sel: string
+  setSel: (id: string) => void
+}) {
+  const i = findings.findIndex((f) => f.id === sel)
+  const prev = i > 0 ? findings[i - 1] : undefined
+  const next = findings[i + 1]
+  const go = (id: string) => {
+    setSel(id)
+    scrollTo({ top: 0, behavior: "instant" })
+  }
+  return (
+    <div className="mt-4 hidden items-center justify-between gap-3 border-t pt-4 lg:flex">
+      <Button type="button" variant="ghost" disabled={!prev} onClick={() => prev && go(prev.id)} className="-ml-2.5 text-muted-foreground">
+        {prev ? `Previous: ${prev.id}` : "Previous"}
+      </Button>
+      <span className="font-mono text-xs text-muted-foreground tabular-nums">
+        {i < 0 ? `${findings.length} findings` : `${i + 1} of ${findings.length}`}
+      </span>
+      <Button type="button" variant="outline" disabled={!next} onClick={() => next && go(next.id)}>
+        {next ? `Next: ${next.id}` : "Next"}
+      </Button>
+    </div>
+  )
+}
