+
+const MOCK_OPT =
+  (typeof window !== "undefined" &&
+    window.localStorage.getItem("frame-menu-opt")) ||
+  "today"
+
+function MockChatItems({
+  opt,
+  branchId,
+  chat,
+  onRename,
+}: {
+  opt: string
+  branchId: string
+  chat: NonNullable<LayerMenuActions["chat"]>
+  onRename: () => void
+}) {
+  const common = {
+    branchId,
+    onRename,
+    onPlay: chat.onPlay,
+    onOpenInBrowser: chat.onOpenInBrowser,
+  }
+  const sub = (icon: React.ReactNode, label: string, body: React.ReactNode) => (
+    <DropdownMenuSub>
+      <DropdownMenuSubTrigger>
+        {icon}
+        {label}
+      </DropdownMenuSubTrigger>
+      <DropdownMenuSubContent>{body}</DropdownMenuSubContent>
+    </DropdownMenuSub>
+  )
+  if (opt === "a")
+    return sub(<AppWindowIcon />, "Preview", <WorkspaceMenuItems {...common} />)
+  if (opt === "b" || opt === "e")
+    return (
+      <>
+        {sub(
+          MOCK_LABEL.icon,
+          MOCK_LABEL.label,
+          <WorkspaceMenuItems {...common} only="preview" audited={opt === "e"} />
+        )}
+        {sub(
+          <ChatCircleIcon />,
+          "Chat",
+          <WorkspaceMenuItems {...common} only="chat" openChat audited={opt === "e"} />
+        )}
+      </>
+    )
+  if (opt === "c")
+    return (
+      <>
+        <DropdownMenuSeparator />
+        <WorkspaceMenuItems {...common} only="preview" />
+        <DropdownMenuSeparator />
+        {sub(
+          <ChatCircleIcon />,
+          "Chat",
+          <WorkspaceMenuItems {...common} only="chat" openChat />
+        )}
+      </>
+    )
+  // d: the preview's items, then Open chat; the chat's own menu stays in its header.
+  return (
+    <>
+      <DropdownMenuSeparator />
+      <WorkspaceMenuItems {...common} only="preview" />
+      <DropdownMenuSeparator />
+      <MockOpenChat branchId={branchId} />
+    </>
+  )
+}
+
+function MockOpenChat({ branchId }: { branchId: string }) {
+  const menu = useChatsMenu()
+  return (
+    <DropdownMenuItem onSelect={() => menu?.onSelectWorkspace(branchId)}>
+      <ChatCircleIcon />
+      Open chat
+    </DropdownMenuItem>
+  )
+}
+
+const MOCK_LABEL = (() => {
+  const k =
+    (typeof window !== "undefined" &&
+      window.localStorage.getItem("frame-menu-label")) ||
+    "a"
+  if (k === "b") return { icon: <MonitorIcon />, label: "Preview" }
+  if (k === "c") return { icon: <PlayIcon />, label: "Prototype" }
+  if (k === "d") return { icon: <TerminalWindowIcon />, label: "Dev server" }
+  return { icon: <AppWindowIcon />, label: "Preview" }
+})()
