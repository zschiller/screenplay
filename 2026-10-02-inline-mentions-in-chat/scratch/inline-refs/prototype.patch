index 83fa7c4..ddc414b 100644
--- a/apps/app/app/globals.css
+++ b/apps/app/app/globals.css
@@ -527,3 +527,68 @@ body {
 .chat-markdown .hljs-strong {
   font-weight: 600;
 }
+
+/* Inline references (exploration prototype, round 2): the outline Badge's
+   square border around an icon and a medium-weight name, sitting on the text
+   baseline. 20px tall, so tokens on adjacent 24px lines keep a gap. */
+.inline-ref {
+  display: inline-flex;
+  align-items: center;
+  /* 14px label + 2px padding + 1px border each way: 20px, the outline
+     Badge's height. The overhang past the 14px text is pulled back with
+     negative margins, so a chip never grows its line box. */
+  padding: 0.125rem 0.375rem;
+  margin-block: -0.1875rem;
+  border: 1px solid var(--border);
+  border-radius: var(--radius-md);
+  font-weight: 500;
+  font-stretch: 98.8%;
+  color: var(--foreground);
+  text-decoration: none;
+  white-space: nowrap;
+  cursor: default;
+}
+/* The label carries the chip's baseline, so the name sits on the line's
+   baseline whatever the icon is. */
+.inline-ref-label {
+  align-self: baseline;
+  line-height: 0.875rem;
+}
+a.inline-ref,
+button.inline-ref,
+.inline-ref[role="link"] {
+  cursor: pointer;
+}
+.inline-ref-icon {
+  display: inline-flex;
+  flex-shrink: 0;
+  align-items: center;
+  justify-content: center;
+  width: 0.875rem;
+  height: 0.875rem;
+  margin-right: 0.25rem;
+  color: currentColor;
+}
+[data-inline-ref="workspace"] > .inline-ref-icon > span {
+  width: 100%;
+  height: 100%;
+}
+/* The composer's and editor's mention nodes render through TipTap's
+   renderHTML, so they draw the document icon as a mask. */
+.inline-ref[data-inline-ref-css="document"]::before {
+  content: "";
+  display: inline-block;
+  flex-shrink: 0;
+  width: 0.875rem;
+  height: 0.875rem;
+  margin-right: 0.25rem;
+  background-color: currentColor;
+  mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 256 256'><path d='M213.66,82.34l-56-56A8,8,0,0,0,152,24H56A16,16,0,0,0,40,40V216a16,16,0,0,0,16,16H200a16,16,0,0,0,16-16V88A8,8,0,0,0,213.66,82.34ZM160,51.31,188.69,80H160ZM200,216H56V40h88V88a8,8,0,0,0,8,8h48V216Zm-32-80a8,8,0,0,1-8,8H96a8,8,0,0,1,0-16h64A8,8,0,0,1,168,136Zm0,32a8,8,0,0,1-8,8H96a8,8,0,0,1,0-16h64A8,8,0,0,1,168,168Z'/></svg>")
+    center / contain no-repeat;
+}
+/* Chat text runs on 22px lines so 20px reference chips on adjacent lines
+   keep a 2px gap. */
+.chat-markdown.text-sm,
+.chat-composer-input {
+  line-height: 1.375rem;
+}
