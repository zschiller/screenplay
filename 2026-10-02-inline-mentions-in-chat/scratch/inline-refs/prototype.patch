diff --git a/apps/app/components/agent/inline-ref.tsx b/apps/app/components/agent/inline-ref.tsx
new file mode 100644
index 0000000..0f11cd7
--- /dev/null
+++ b/apps/app/components/agent/inline-ref.tsx
@@ -0,0 +1,60 @@
+"use client"
+
+import type { ComponentProps, ReactNode } from "react"
+import {
+  CrosshairIcon,
+  FileTextIcon,
+  FrameCornersIcon,
+  ScribbleIcon,
+} from "@workspace/ui/components/icons"
+import { cn } from "@workspace/ui/lib/utils"
+
+/**
+ * One way to name a thing inline in a chat message: a Workspace, a document, a
+ * frame, a mockup, a targeted element or a skill. Bold text, no underline, led
+ * by the thing's icon (a Workspace's is its state glyph). The look lives in
+ * the `.inline-ref` rules in `app/globals.css`, which the composer's and the
+ * document editor's mention nodes share.
+ */
+export type InlineRefKind =
+  | "workspace"
+  | "document"
+  | "frame"
+  | "mockup"
+  | "element"
+  | "skill"
+
+const ICONS: Partial<Record<InlineRefKind, typeof FileTextIcon>> = {
+  document: FileTextIcon,
+  frame: FrameCornersIcon,
+  mockup: ScribbleIcon,
+  element: CrosshairIcon,
+}
+
+export function InlineRef({
+  kind,
+  icon,
+  children,
+  className,
+  ...props
+}: {
+  kind: InlineRefKind
+  /** Replaces the kind's icon: a Workspace passes its state glyph. */
+  icon?: ReactNode
+} & ComponentProps<"span">) {
+  const Icon = ICONS[kind]
+  return (
+    <span
+      data-inline-ref={kind}
+      className={cn("inline-ref", className)}
+      {...props}
+    >
+      {icon ? (
+        <span className="inline-ref-icon">{icon}</span>
+      ) : (
+        Icon && <Icon aria-hidden className="inline-ref-icon" />
+      )}
+      <span className="inline-ref-label">{children}</span>
+    </span>
+  )
+}
