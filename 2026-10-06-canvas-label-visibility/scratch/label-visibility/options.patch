diff --git a/apps/app/components/canvas/lx-labels.ts b/apps/app/components/canvas/lx-labels.ts
new file mode 100644
index 0000000..2ba02a5
--- /dev/null
+++ b/apps/app/components/canvas/lx-labels.ts
@@ -0,0 +1,93 @@
+"use client"
+// EXPLORATION ONLY (label visibility round 1) — never commit.
+import { useEffect } from "react"
+import { getGroupMembers } from "@/lib/canvas/layout"
+import type { LabelLayer } from "./label-layer"
+
+type R = { id: string; x: number; y: number; width: number; height: number }
+
+export const LX: string | null =
+  typeof window === "undefined" ? null : window.localStorage.getItem("lx")
+
+const NAME = 20
+const GROUP = 22
+const MINW = 64
+
+function overlaps(a: Omit<R, "id">, b: Omit<R, "id">) {
+  return a.x < b.x + b.width && b.x < a.x + a.width && a.y < b.y + b.height && b.y < a.y + a.height
+}
+
+type State = { hidden: boolean; names: boolean; group: boolean }
+
+export function lxStates(rects: R[], groups: { members: string[] }[], z: number, textW: Map<string, { name: number; group: number }> = new Map()) {
+  const out = new Map<string, State>()
+  const grouped = new Set(groups.flatMap((g) => g.members))
+  const all = [...groups.map((g) => g.members), ...rects.filter((r) => !grouped.has(r.id)).map((r) => [r.id])]
+  for (const ids of all) {
+    const ms = ids.map((id) => rects.find((r) => r.id === id)).filter((r): r is R => !!r)
+    if (!ms.length) continue
+    const L = ms[0]
+    const hasGL = ms.length > 1
+    const top = Math.min(...ms.map((m) => m.y))
+    const right = Math.max(...ms.map((m) => m.x + m.width))
+    const clear = (h: number, x = L.x, w = right - L.x) => {
+      const strip = { x, y: top - h / z, width: w, height: h / z }
+      return !rects.some((o) => !ids.includes(o.id) && overlaps(strip, o))
+    }
+    const wide = (m: R) => m.width * z >= MINW - 1e-3
+    const set = (m: R, s: State) => out.set(m.id, s)
+    if (LX === "a") {
+      const namesRoom = clear(NAME)
+      const groupRoom = hasGL && clear(NAME + GROUP)
+      for (const m of ms) {
+        const shown = namesRoom && wide(m)
+        set(m, { hidden: !shown, names: true, group: m === L && groupRoom && shown })
+      }
+    } else if (LX === "b") {
+      for (const m of ms) set(m, { hidden: !wide(m), names: true, group: m === L && hasGL && wide(m) })
+    } else if (LX === "c") {
+      const full = clear(hasGL ? NAME + GROUP : NAME) && ms.every(wide)
+      const groupOnly = hasGL && !full && clear(NAME) && (right - L.x) * z >= MINW
+      for (const m of ms) {
+        if (full) set(m, { hidden: false, names: true, group: m === L && hasGL })
+        else if (groupOnly) set(m, { hidden: m !== L, names: false, group: m === L })
+        else set(m, { hidden: true, names: true, group: false })
+      }
+    }
+  }
+  return out
+}
+
+export function useLxLabels(
+  labelLayer: LabelLayer | null,
+  layouts: Map<string, { x: number; y: number; width: number; height: number }>,
+  groups: readonly Parameters<typeof getGroupMembers>[0][]
+) {
+  useEffect(() => {
+    if (!LX || !labelLayer) return
+    const rects = [...layouts.entries()].map(([id, l]) => ({ id, x: l.x, y: l.y, width: l.width, height: l.height }))
+    const gs = groups.map((g) => ({ members: getGroupMembers(g).map((m) => m.id) }))
+    const apply = () => {
+      const z = labelLayer.camera.get().zoom
+      const textW = new Map<string, { name: number; group: number }>()
+      for (const el of labelLayer.element.querySelectorAll<HTMLElement>("[data-layer-label]")) {
+        const kids = [...el.children] as HTMLElement[]
+        const g = kids.find((k) => k.querySelector(".group\\/group-label"))
+        const n = kids.find((k) => k !== g)
+        const inner = (k?: HTMLElement) => (k ? Math.max(0, ...[...k.querySelectorAll<HTMLElement>(".group\\/layer-label, .group\\/group-label")].map((e) => [...e.children].reduce((w, c) => w + (c as HTMLElement).getBoundingClientRect().width + 8, -8))) : 0)
+        textW.set(el.getAttribute("data-layer-label")!, { name: inner(n), group: inner(g) })
+      }
+      for (const [id, s] of lxStates(rects, gs, z, textW)) {
+        const el = labelLayer.element.querySelector(`[data-layer-label="${id}"]`)
+        if (!el) continue
+        el.toggleAttribute("data-lx-hidden", s.hidden)
+        el.toggleAttribute("data-lx-names-hidden", !s.names)
+        el.toggleAttribute("data-lx-group-hidden", !s.group)
+      }
+    }
+    apply()
+    const t = setInterval(apply, 250)
+    const un = labelLayer.camera.subscribe(apply)
+    return () => { un(); clearInterval(t) }
+  }, [labelLayer, layouts, groups])
+}
