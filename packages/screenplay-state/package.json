{
  "name": "@screenplay.space/state",
  "version": "0.1.0",
  "description": "Mirror a prototype's UI state up to the screenplay canvas as a read-only synced view alongside the artboard.",
  "keywords": [
    "screenplay",
    "state",
    "react",
    "devtools",
    "yjs"
  ],
  "license": "MIT",
  "homepage": "https://screenplay.space",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zschiller/screenplay.git",
    "directory": "packages/screenplay-state"
  },
  "bugs": {
    "url": "https://github.com/zschiller/screenplay/issues"
  },
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=17"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@workspace/typescript-config": "workspace:*",
    "react": "^19.2.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc --noEmit"
  }
}
