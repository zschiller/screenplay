{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // The extensions folder is git-ignored, and turbo's default inputs skip
    // git-ignored files, so without these globs a changed (or broken)
    // extension would replay a cached typecheck or build. Explicit globs hash
    // the files regardless of .gitignore.
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "extensions/**",
        "!extensions/*/node_modules/**",
      ],
    },
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "extensions/**",
        "!extensions/*/node_modules/**",
      ],
    },
  },
}
