{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": false,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@/*": ["./*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"],
      "@extensions/server": [
        "./lib/extensions/server.generated.ts",
        "./lib/extensions/server.empty.ts"
      ],
      "@extensions/client": [
        "./lib/extensions/client.generated.ts",
        "./lib/extensions/client.empty.ts"
      ]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "extensions/*/node_modules"]
}
