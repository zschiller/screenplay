# Copy this file to .env.local and fill in the values.
# See README.md for where each value comes from.

# --- Clerk (auth) ---
# https://dashboard.clerk.com → your app → API Keys
# Enable GitHub as a social connection with the `repo` scope so the app can
# clone private repos and push commits on the user's behalf.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_

# --- Liveblocks (real-time canvas) ---
# https://liveblocks.io/dashboard → your project → API keys → Secret key
LIVEBLOCKS_SECRET_KEY=sk_

# --- Anthropic (agent) ---
# https://console.anthropic.com/settings/keys
# Read automatically by @anthropic-ai/sdk.
ANTHROPIC_API_KEY=sk-ant-

# --- Upstash Redis / Vercel KV (agent + env-var storage) ---
# Easiest: add the Upstash integration in the Vercel Marketplace and run
# `vercel env pull .env.local` — these variables will be filled in for you.
# Otherwise copy them from the Upstash Redis dashboard → REST API tab.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Env-var encryption ---
# 32 random bytes, hex-encoded (64 hex chars). Used by lib/env-store.ts to
# encrypt per-workspace env vars before storing them in Redis.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Vercel Sandbox ---
# Authenticated via OIDC. On Vercel this is injected automatically.
# Locally: run `vercel link` once, then `vercel env pull .env.local` to
# populate VERCEL_OIDC_TOKEN (valid ~12h — re-pull when it expires).
# VERCEL_OIDC_TOKEN=

# --- Sandbox git credential broker ---
# Signs short-lived JWTs that the in-sandbox git credential helper presents
# when minting the acting user's GitHub token. Any strong random string.
# Generate with: openssl rand -hex 32
# (Local dev doesn't exercise the broker path — the sandbox falls back to
# embedding your token in the git remote URL since localhost isn't
# reachable from inside the sandbox.)
SANDBOX_JWT_SECRET=
