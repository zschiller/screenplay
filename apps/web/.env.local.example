# Copy this file to .env.local and fill in the values.
# See README.md for where each value comes from.

# --- Better Auth ---
# Random 32+ byte secret used to sign session tokens and cookies.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL where the app is served (used for OAuth callbacks).
# Locally: http://localhost:3000. On Vercel: your production URL.
BETTER_AUTH_URL=http://localhost:3000

# --- Postgres (Better Auth + per-user app state + KV table) ---
# Full connection string. Neon/Supabase/Railway all provide one.
# Point at an empty database — the schema auto-creates on first request
# (see lib/db.ts `ensureSchema`).
DATABASE_URL=

# --- GitHub OAuth (sign-in + cloning/pushing user repos) ---
# Create a GitHub OAuth App:
#   https://github.com/settings/developers → "New OAuth App"
# Authorization callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
# Request the `repo` scope so the app can clone private repos and push
# commits on the user's behalf (configured in lib/auth.ts).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Liveblocks (real-time canvas) ---
# https://liveblocks.io/dashboard → your project → API keys → Secret key
LIVEBLOCKS_SECRET_KEY=sk_

# --- Anthropic (agent) ---
# https://console.anthropic.com/settings/keys
# Read automatically by @anthropic-ai/sdk.
ANTHROPIC_API_KEY=sk-ant-

# --- Env-var encryption ---
# 32 random bytes, hex-encoded (64 hex chars). Used by lib/env-store.ts to
# encrypt per-workspace env vars before storing them in the kv table.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Vercel Sandbox ---
# Authenticated via OIDC. On Vercel this is injected automatically.
# Locally: run `vercel link` once, then `vercel env pull .env.local` to
# populate VERCEL_OIDC_TOKEN (valid ~12h — re-pull when it expires).
# VERCEL_OIDC_TOKEN=
