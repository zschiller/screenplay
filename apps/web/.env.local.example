# Copy this file to .env.local and fill in the values.
# See README.md for where each value comes from.

# --- Better Auth ---
# Random 32+ byte secret used to sign session tokens, cookies, and the
# encrypted payload the oAuthProxy plugin passes between preview deployments
# and production. Must be identical across prod + preview + local dev.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# BETTER_AUTH_URL is derived automatically — localhost in dev, VERCEL_URL on
# preview deploys, VERCEL_PROJECT_PRODUCTION_URL for the OAuth proxy target.
# Only set it explicitly if you're hosting somewhere exotic.
# BETTER_AUTH_URL=

# --- Postgres (Better Auth + per-user app state + KV table) ---
# Full connection string. Neon/Supabase/Railway all provide one.
# Apply the schema once (and on future changes) with `pnpm db:push`.
DATABASE_URL=

# --- GitHub OAuth (sign-in + cloning/pushing user repos) ---
# One OAuth App is shared across production, preview, and local dev.
# Create it at https://github.com/settings/developers → "New OAuth App".
# Authorization callback URL: <your-production-url>/api/auth/callback/github
# (For local dev, GitHub allows http://localhost:3000/api/auth/callback/github
# as a second app if you want — but the shared one works too.)
# The `repo` scope is requested in lib/auth.ts so the app can clone private
# repos and push commits on the user's behalf. Preview deployments bounce
# through production via the oAuthProxy plugin.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Liveblocks (real-time canvas) ---
# https://liveblocks.io/dashboard → your project → API keys → Secret key
LIVEBLOCKS_SECRET_KEY=sk_

# --- Anthropic (agent) ---
# https://console.anthropic.com/settings/keys
# Read automatically by @anthropic-ai/sdk.
ANTHROPIC_API_KEY=sk-ant-

# --- Env-var encryption ---
# 32 random bytes, hex-encoded (64 hex chars). Used by lib/env-store.ts to
# encrypt per-workspace env vars before storing them in the kv table.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Vercel Sandbox ---
# Authenticated via OIDC. On Vercel this is injected automatically.
# Locally: run `vercel link` once, then `vercel env pull .env.local` to
# populate VERCEL_OIDC_TOKEN (valid ~12h — re-pull when it expires).
# VERCEL_OIDC_TOKEN=
