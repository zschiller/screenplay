# Copy this file to .env.local and fill in the values.
# See README.md for where each value comes from.

# --- Better Auth ---
# Where THIS deployment lives. Required in production. Optional locally (we
# default to http://localhost:$PORT, falling back to port 3000). On Vercel
# preview deploys, leave unset — we fall back to https://$VERCEL_URL.
# BETTER_AUTH_URL=http://localhost:3000

# The stable production URL registered with the GitHub OAuth app. This is the
# same value on every environment — preview deploys need it to proxy the
# OAuth callback through production. Example: https://build.screenplay.space
BETTER_AUTH_PRODUCTION_URL=

# 32 random bytes, hex-encoded (openssl rand -hex 32). Signs session cookies
# and oAuthProxy state.
#
# Production + preview MUST share the same value: preview sign-ins are
# redirected to the production callback, which signs state with this secret,
# then bounces back to the preview — the preview deploy reads that state and
# can only verify it if its secret matches.
#
# Locally you have two options:
#  (a) copy the production value into .env.local — simplest, same GitHub
#      OAuth app, same secret
#  (b) create a separate dev-only GitHub OAuth app with a
#      http://localhost:3000/api/auth/callback/github callback, set
#      BETTER_AUTH_PRODUCTION_URL=http://localhost:3000, and use any random
#      secret here — the proxy is a no-op when current == production
BETTER_AUTH_SECRET=

# --- GitHub OAuth App ---
# https://github.com/settings/developers → New OAuth App
# Authorization callback URL: $BETTER_AUTH_PRODUCTION_URL/api/auth/callback/github
# The app requests the `repo` scope so Screenplay can clone private repos and
# push commits on the user's behalf.
#
# The same OAuth app is shared across production and all preview deploys (the
# oAuthProxy plugin routes preview sign-ins through the production callback
# and then redirects back to the preview URL). If you'd rather not share the
# production secret with local dev, make a second OAuth app pointed at
# http://localhost:3000/api/auth/callback/github — see option (b) above.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Postgres (Drizzle) ---
# Postgres connection string. Any Postgres works — the default factory
# (lib/db/neon.ts) uses Neon's serverless HTTP driver, but you can swap it
# for postgres-js / node-postgres / etc. See the README section
# "Using a different Postgres driver".
# Used by Better Auth (user/session/account), per-user organization state,
# lib/kv (cached agent/env ids, distributed locks, encrypted workspace env
# vars), project rooms + members (gates Yjs-host token issuance), and
# canvas comment threads.
DATABASE_URL=

# --- Yjs host ---
# Credentials for whatever Yjs host is configured. The host stores the
# per-room Y.Doc (canvas state, agent stream events, awareness) and syncs it
# to clients. Any Yjs-compatible backend works — the default implementation
# targets Liveblocks and only needs a server-side secret key from
# https://liveblocks.io/dashboard → API keys → Secret key. It's consumed by
# lib/yjs-host/liveblocks-server.ts and never leaves the server. To point at
# a different host (Hocuspocus, y-websocket, Cloudflare Durable Objects, …),
# add sibling *-server.ts / *-client.tsx files under lib/yjs-host/, flip the
# re-exports in lib/yjs-host/index.ts + lib/yjs-host/client.tsx, and set
# whatever env vars that host needs instead of LIVEBLOCKS_SECRET_KEY.
LIVEBLOCKS_SECRET_KEY=sk_

# --- Model providers (agent) ---
# At least one provider must be configured. Each is implemented as a
# concrete file under apps/web/lib/agent/providers/ and self-detects via
# the env vars below; unset providers are skipped from the picker. The
# model picker is populated live by hitting each configured provider's
# discovery endpoint (`/v1/models`, the Google list-models API, or
# `gateway.getAvailableModels()` for the Vercel AI Gateway), cached for
# an hour in lib/kv. No static catalog to keep up to date.
#
# Model ids are fully qualified: "<provider>:<model>". The default model
# AGENT_DEFAULT_MODEL must reference a provider that's actually configured.
# AGENT_DEFAULT_MODEL=anthropic:claude-sonnet-4-6

# Anthropic — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-

# OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-

# Google (Gemini) — https://aistudio.google.com/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=

# Vercel AI Gateway — routes through https://ai-gateway.vercel.sh, exposing
# hundreds of models behind a unified API with budgets, analytics, failover,
# and BYOK. On Vercel deploys, OIDC auth is injected automatically (same
# token Vercel Sandbox uses); locally, set AI_GATEWAY_API_KEY from your
# project's AI Gateway dashboard.
# AI_GATEWAY_API_KEY=

# Generic OpenAI-compatible endpoint — for any non-Vercel host that speaks
# the OpenAI HTTP protocol: OpenRouter, Groq, Together, vLLM, LM Studio, an
# internal LiteLLM proxy, etc. The picker discovers models from
# `${BASE_URL}/v1/models`. (For Vercel AI Gateway specifically, use
# AI_GATEWAY_API_KEY above instead — that path uses Vercel's dedicated SDK
# and gets you the extra Gateway features.)
# OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPATIBLE_API_KEY=

# --- Env-var encryption ---
# 32 random bytes, hex-encoded (64 hex chars). Used by lib/env-store.ts to
# encrypt per-workspace env vars before storing them in Postgres.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Vercel Sandbox ---
# Authenticated via OIDC. On Vercel this is injected automatically.
# Locally: run `vercel link` once, then `vercel env pull .env.local` to
# populate VERCEL_OIDC_TOKEN (valid ~12h — re-pull when it expires).
# VERCEL_OIDC_TOKEN=

# --- Thumbnail capture ---
# HMAC secret for the short-lived tokens that gate /[roomId]/render. The
# capture pipeline (Puppeteer) hits that route with a signed token because it
# can't carry a user session — this secret is what proves the token came from
# our server. Any long random string works.
# Generate with: openssl rand -hex 32
THUMBNAIL_RENDER_SECRET=

# --- Blob store ---
# Credentials for whatever blob store is configured. The default
# implementation (lib/blob/vercel.ts) wraps Vercel Blob and only needs a
# read/write token. On Vercel, connect a Blob store to your project and
# BLOB_READ_WRITE_TOKEN is injected automatically; locally, run `vercel env
# pull .env.local` after connecting the store. To point at a different
# backend (S3, R2, GCS, MinIO, …), add a sibling factory under lib/blob/,
# flip the import in lib/blob/index.ts, and set whatever env vars that
# backend needs instead.
BLOB_READ_WRITE_TOKEN=
