{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screenplay",
  "version": "0.0.1",
  "identifier": "space.screenplay.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Screenplay",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/icon.icns",
      "icons/Screenplay.icon"
    ],
    "resources": ["resources/sidecar.tar.gz"]
  }
}
