{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screenplay",
  "version": "0.1.1",
  "identifier": "space.screenplay.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Screenplay",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "url": "index.html",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 26 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/icon.icns",
      "icons/icon.car"
    ]
  }
}
