# The desktop build profile — issue #418.
#
# This is the single "build-time switch" that flips every swappable backend to
# its local implementation at once. Each seam still reads its own env var (the
# per-seam switches landed independently and stay independent by design); this
# file is where the desktop distribution sets them together, so one repo
# produces both the hosted deployment (none of these set) and the desktop app.
#
# `scripts/build-sidecar.mjs` loads this and runs `next build` with it. The vars
# split two ways:
#   - NEXT_PUBLIC_* and SCREENPLAY_DESKTOP are read at BUILD time (inlined into
#     the bundle / toggle `output: standalone`).
#   - The seam selectors (SANDBOX_BACKEND, SCREENPLAY_DB, BLOB_STORE,
#     AGENT_ENGINE, THUMBNAIL_CAPTURER, SCREENPLAY_ACP_HARNESS) are read at
#     RUNTIME by the sidecar. They're listed here too so the build and the
#     runtime agree, and the Tauri shell re-injects them at sidecar spawn.
#
# The machine-specific runtime vars are NOT here — the shell computes them per
# launch: PORT, HOSTNAME, TAURI_CONTROL_URL, and the on-disk data dirs
# (PGLITE_DATA_DIR, YJS_PERSISTENCE_DIR, LOCAL_BLOB_DIR, LOCAL_BLOB_BASE_URL,
# PGLITE_MIGRATIONS_DIR) under the OS app-data directory.

# --- build-time (inlined by `next build`) ---
SCREENPLAY_DESKTOP=1
NEXT_PUBLIC_SCREENPLAY_LOCAL=1
NEXT_PUBLIC_YJS_HOST=local
# The webview serves the app at the origin root — no `/app` proxy prefix (that's
# the hosted two-app split). Empty overrides any NEXT_PUBLIC_BASE_PATH a
# developer's .env.local sets for hosted dev.
NEXT_PUBLIC_BASE_PATH=

# --- runtime seam selection (also applied at build so module-load agrees) ---
SANDBOX_BACKEND=local
SCREENPLAY_DB=pglite
BLOB_STORE=local-fs
AGENT_ENGINE=external
THUMBNAIL_CAPTURER=tauri-webview
SCREENPLAY_ACP_HARNESS=claude

# The GitHub App client id for the optional "Connect GitHub" device flow
# (PRD #428). Deliberately unset here — released builds get it baked into the
# shell at compile time (`option_env!` in sidecar.rs, set from the
# SCREENPLAY_GITHUB_CLIENT_ID repo variable by desktop-release.yml). When
# unset the connect affordance doesn't offer itself; `gh` and the
# URL/local-folder no-auth floor still work.
# SCREENPLAY_GITHUB_CLIENT_ID=
