{
  "name": "docs",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port ${PORT:-3002}",
    "build": "next build && pnpm run search-index",
    "search-index": "pagefind --site .next/server/app --output-path public/_pagefind",
    "start": "next start --port ${PORT:-3002}",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "screenshots": "pnpm --filter app screenshots:docs"
  },
  "dependencies": {
    "@workspace/ui": "workspace:*",
    "next": "16.3.8",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.8",
    "pagefind": "^1.5.2",
    "typescript": "^5.9.3"
  }
}
