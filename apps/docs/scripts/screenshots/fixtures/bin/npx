#!/bin/sh
# Docs-screenshot shim for `npx` (see ../../README.md).
#
# Screenplay starts Claude Code's ACP adapter with
# `npx -y @agentclientprotocol/claude-agent-acp@<version>`. Route that to the
# scripted agent so conversations are deterministic; pass everything else to
# the real npx.
case "$*" in
  *@agentclientprotocol/claude-agent-acp*)
    exec node "$(dirname "$0")/../scripted-agent.mjs"
    ;;
esac
exec "${DOCS_REAL_NPX:-/usr/bin/npx}" "$@"
