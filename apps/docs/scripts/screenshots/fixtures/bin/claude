#!/bin/sh
# Docs-screenshot shim for the `claude` CLI (see ../../README.md).
#
# Screenplay names new branches and chats by running `claude -p <prompt>`.
# Answer those deterministically; hand anything else (e.g. a terminal tab
# launching Claude Code) to the real CLI when one is installed.
for arg in "$@"; do
  if [ "$arg" = "-p" ] || [ "$arg" = "--print" ]; then
    case "$*" in
      *FAQ*) printf 'pricing-faq\nPricing FAQ\n' ;;
      *checklist*) printf 'Launch Checklist\n' ;;
      *gradient*) printf 'hero-gradient-trust-line\nHero Gradient & Trust Line\n' ;;
      *) printf 'quick-change\nQuick Change\n' ;;
    esac
    exit 0
  fi
done
if [ -n "$DOCS_REAL_CLAUDE" ] && [ -x "$DOCS_REAL_CLAUDE" ]; then
  exec "$DOCS_REAL_CLAUDE" "$@"
fi
echo "Claude Code (docs screenshot stand-in)"
exec "${SHELL:-/bin/sh}"
