# local build on-disk state (PRD #404) — never committed:
#  - PGlite embedded-Postgres files at PGLITE_DATA_DIR (defaults to ./.pglite)
#  - the local Yjs host's persisted Y.Docs at YJS_PERSISTENCE_DIR
#    (defaults to ./.data/yjs)
.pglite/
*.pglite
.data/

# typescript
*.tsbuildinfo
next-env.d.ts
.vercel

# desktop shell (apps/desktop) build artifacts — issue #418
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/resources/sidecar.tar.gz
apps/desktop/.build-pglite/

# desktop release credentials — issue #631 (never commit signing secrets)
apps/desktop/.env.release
apps/desktop/*.p8
