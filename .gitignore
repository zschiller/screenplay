# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# turbo
.turbo

# production
build
dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files
.env*.local

# local build on-disk state (PRD #404) — never committed:
#  - PGlite embedded-Postgres files at PGLITE_DATA_DIR (defaults to ./.pglite)
#  - the local Yjs host's persisted Y.Docs at YJS_PERSISTENCE_DIR
#    (defaults to ./.data/yjs)
.pglite/
*.pglite
.data/

# screenshot harness state + capture output (issue #716) — never committed:
#  - the throwaway PGlite dir, Y.Docs, blobs, and minted secrets
#  - capture sets (the committed sample set lives in apps/app/screenshots/sample/)
apps/app/.screenshots/

# typescript
*.tsbuildinfo
next-env.d.ts
.vercel

# desktop shell (apps/desktop) build artifacts — issue #418
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/resources/sidecar.tar.gz
apps/desktop/.build-pglite/

# desktop release credentials — issue #631 (never commit signing secrets)
apps/desktop/.env.release
apps/desktop/*.p8

# desktop icon catalog — generated by build-icon.mjs at release time (issue #632)
apps/desktop/src-tauri/icons/icon.car
apps/desktop/src-tauri/icons/dmg-volume.icns

# Pagefind search index, built by `pnpm build` (apps/docs)
apps/docs/public/_pagefind
